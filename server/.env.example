# Copiez ce fichier en .env et renseignez de vraies valeurs avant tout deploiement.
# Ne jamais committer le fichier .env (deja exclu via .gitignore).

# En developpement : "file:./dev.db" (SQLite). En production : utilisez PostgreSQL,
# ex. "postgresql://user:password@host:5432/vefalys"
DATABASE_URL="file:./dev.db"

# OBLIGATOIRE en production : generez une valeur aleatoire forte, par exemple avec
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Ne jamais reutiliser la valeur de developpement. La rotation de ce secret deconnecte
# tous les utilisateurs (leurs tokens existants deviennent invalides).
JWT_SECRET="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

PORT=4000

# URL exacte (avec https://) du frontend deploye. Doit correspondre precisement
# (schema + domaine + port) a l'origine depuis laquelle l'app est servie, sinon le
# navigateur bloquera les requetes (CORS).
CLIENT_URL="https://votre-domaine.fr"

# URL publique HTTPS de l'API elle-meme (necessaire pour que Calendly puisse appeler le
# webhook en temps reel). Sans cette variable, la synchronisation Calendly fonctionne quand
# meme via sondage periodique (toutes les 10 min) et le bouton "Synchroniser maintenant".
# PUBLIC_APP_URL="https://api.votre-domaine.fr"

# Definir NODE_ENV=production desactive les messages d'erreur detailles cote client
# et active les verifications de securite au demarrage (voir src/index.ts).
NODE_ENV=production
