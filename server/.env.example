# Copiez ce fichier en .env et renseignez de vraies valeurs avant tout deploiement.
# Ne jamais committer le fichier .env (deja exclu via .gitignore).

# En developpement : "file:./dev.db" (SQLite). En production : utilisez PostgreSQL,
# ex. "postgresql://user:password@host:5432/vefalys"
DATABASE_URL="file:./dev.db"

# OBLIGATOIRE en production : generez une valeur aleatoire forte, par exemple avec
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Ne jamais reutiliser la valeur de developpement. La rotation de ce secret deconnecte
# tous les utilisateurs (leurs tokens existants deviennent invalides).
JWT_SECRET="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

PORT=4000

# URL exacte (avec https://) du frontend deploye. Doit correspondre precisement
# (schema + domaine + port) a l'origine depuis laquelle l'app est servie, sinon le
# navigateur bloquera les requetes (CORS).
CLIENT_URL="https://votre-domaine.fr"

# URL publique HTTPS de l'API elle-meme (necessaire pour que Calendly puisse appeler le
# webhook en temps reel). Sans cette variable, la synchronisation Calendly fonctionne quand
# meme via sondage periodique (toutes les 10 min) et le bouton "Synchroniser maintenant".
# PUBLIC_APP_URL="https://api.votre-domaine.fr"

# Definir NODE_ENV=production desactive les messages d'erreur detailles cote client
# et active les verifications de securite au demarrage (voir src/index.ts).
NODE_ENV=production

# URL publique du frontend utilisee dans les emails (lien de confirmation, lien de connexion).
# Sans cette variable, CLIENT_URL ci-dessus est reutilisee.
# PUBLIC_CLIENT_URL="https://votre-domaine.fr"

# SMTP pour l'envoi reel des emails (confirmation d'inscription, validation de compte par un
# administrateur). Sans SMTP_HOST, les emails sont simplement journalises dans la console du
# serveur - pratique en developpement, insuffisant en production.
#
# Les emails sont deja prepares pour partir de "Vefalys <noreply@vefalys.fr>" (voir
# src/lib/mailer.ts). Cette adresse n'existe pas encore : avant la mise en ligne, il faut
# 1) creer la boite noreply@vefalys.fr (ou un alias) chez l'hebergeur du domaine vefalys.fr,
# 2) choisir un fournisseur SMTP pour l'envoi (Brevo, Mailgun, SES, OVH...) et y declarer ce
#    domaine expediteur, 3) renseigner SPF/DKIM/DMARC sur la zone DNS de vefalys.fr pour eviter
#    que ces emails finissent en spam, 4) remplir les variables ci-dessous avec les identifiants
#    obtenus. Rien de tout cela n'est fait automatiquement par le code.
# SMTP_HOST="smtp.votre-fournisseur.fr"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="votre-identifiant"
# SMTP_PASS="votre-mot-de-passe"
# SMTP_FROM="Vefalys <noreply@vefalys.fr>"
